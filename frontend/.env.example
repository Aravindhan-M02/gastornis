# Copy this to .env for local dev if your backend runs on a different port,
# or set VITE_API_BASE_URL as a build-time environment variable on Render
# (Static Site / Web Service settings) so the deployed frontend calls your
# deployed backend instead of localhost.
#
# Example for local dev (default already used if this var is unset):
# VITE_API_BASE_URL=http://localhost:8080
#
# Example for production, once your backend is deployed on Render:
# VITE_API_BASE_URL=https://gastornis-backend.onrender.com
VITE_API_BASE_URL=
